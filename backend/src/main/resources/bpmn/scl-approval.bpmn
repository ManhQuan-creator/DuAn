        <omgdi:waypoint x="700" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_update_bkh_to_gw_bkh_di" bpmnElement="flow_update_bkh_to_gw_bkh">
        <omgdi:waypoint x="800" y="298" />
        <omgdi:waypoint x="845" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_bkh_approve_di" bpmnElement="flow_bkh_approve">
        <omgdi:waypoint x="895" y="298" />
        <omgdi:waypoint x="950" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_bkh_return_di" bpmnElement="flow_bkh_return">
        <omgdi:waypoint x="870" y="323" />
        <omgdi:waypoint x="870" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_bkh_reject_di" bpmnElement="flow_bkh_reject">
        <omgdi:waypoint x="870" y="323" />
        <omgdi:waypoint x="870" y="380" />
        <omgdi:waypoint x="1600" y="380" />
        <omgdi:waypoint x="1600" y="900" />
      </bpmndi:BPMNEdge>

      <!-- TXD edges -->
      <bpmndi:BPMNEdge id="flow_notify_txd_to_txd_di" bpmnElement="flow_notify_txd_to_txd">
        <omgdi:waypoint x="1050" y="298" />
        <omgdi:waypoint x="1100" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_txd_to_update_txd_di" bpmnElement="flow_txd_to_update_txd">
