        <omgdi:waypoint x="1970" y="680" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_revision_tgd_to_gw_di" bpmnElement="flow_revision_tgd_to_gw">
        <omgdi:waypoint x="1970" y="760" />
        <omgdi:waypoint x="1970" y="800" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_revision_tgd_resubmit_di" bpmnElement="flow_revision_tgd_resubmit">
        <omgdi:waypoint x="1945" y="825" />
        <omgdi:waypoint x="450" y="825" />
        <omgdi:waypoint x="450" y="338" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_revision_tgd_cancel_di" bpmnElement="flow_revision_tgd_cancel">
        <omgdi:waypoint x="1970" y="850" />
        <omgdi:waypoint x="1970" y="940" />
        <omgdi:waypoint x="1650" y="940" />
      </bpmndi:BPMNEdge>

      <!-- Return HDTV edges -->
      <bpmndi:BPMNEdge id="flow_return_hdtv_to_notify_di" bpmnElement="flow_return_hdtv_to_notify">
        <omgdi:waypoint x="2520" y="520" />
        <omgdi:waypoint x="2520" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_return_from_hdtv_di" bpmnElement="flow_return_from_hdtv">
        <omgdi:waypoint x="2470" y="600" />
        <omgdi:waypoint x="1700" y="600" />
        <omgdi:waypoint x="1700" y="338" />
      </bpmndi:BPMNEdge>

      <!-- Reject edges -->
      <bpmndi:BPMNEdge id="flow_rejected_to_notify_di" bpmnElement="flow_rejected_to_notify">
        <omgdi:waypoint x="1650" y="940" />
        <omgdi:waypoint x="1700" y="940" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_notify_reject_to_end_di" bpmnElement="flow_notify_reject_to_end">
        <omgdi:waypoint x="1800" y="940" />
        <omgdi:waypoint x="1850" y="940" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

