      <bpmndi:BPMNEdge id="flow_notify_done_to_end_di" bpmnElement="flow_notify_done_to_end">
        <omgdi:waypoint x="2850" y="298" />
        <omgdi:waypoint x="2900" y="298" />
      </bpmndi:BPMNEdge>

      <!-- Return BKH edges -->
      <bpmndi:BPMNEdge id="flow_return_bkh_to_notify_di" bpmnElement="flow_return_bkh_to_notify">
        <omgdi:waypoint x="870" y="520" />
        <omgdi:waypoint x="870" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_notify_return_bkh_to_revision_di" bpmnElement="flow_notify_return_bkh_to_revision">
        <omgdi:waypoint x="870" y="640" />
        <omgdi:waypoint x="870" y="680" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_revision_bkh_to_gw_di" bpmnElement="flow_revision_bkh_to_gw">
        <omgdi:waypoint x="870" y="760" />
        <omgdi:waypoint x="870" y="800" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_revision_bkh_resubmit_di" bpmnElement="flow_revision_bkh_resubmit">
        <omgdi:waypoint x="845" y="825" />
        <omgdi:waypoint x="450" y="825" />
        <omgdi:waypoint x="450" y="338" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_revision_bkh_cancel_di" bpmnElement="flow_revision_bkh_cancel">
        <omgdi:waypoint x="870" y="850" />
        <omgdi:waypoint x="870" y="940" />
        <omgdi:waypoint x="1550" y="940" />
      </bpmndi:BPMNEdge>

      <!-- Return TXD edges -->
      <bpmndi:BPMNEdge id="flow_return_txd_to_notify_di" bpmnElement="flow_return_txd_to_notify">
        <omgdi:waypoint x="1420" y="520" />
        <omgdi:waypoint x="1420" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_return_from_txd_di" bpmnElement="flow_return_from_txd">
        <omgdi:waypoint x="1370" y="600" />
        <omgdi:waypoint x="600" y="600" />
        <omgdi:waypoint x="600" y="338" />
      </bpmndi:BPMNEdge>

      <!-- Return TGD edges -->
      <bpmndi:BPMNEdge id="flow_return_tgd_to_notify_di" bpmnElement="flow_return_tgd_to_notify">
        <omgdi:waypoint x="1970" y="520" />
        <omgdi:waypoint x="1970" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_return_tgd_to_revision_di" bpmnElement="flow_return_tgd_to_revision">
