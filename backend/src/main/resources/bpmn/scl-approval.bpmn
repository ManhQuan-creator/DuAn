        <omgdi:waypoint x="2520" y="380" />
        <omgdi:waypoint x="1620" y="380" />
        <omgdi:waypoint x="1620" y="900" />
      </bpmndi:BPMNEdge>

      <!-- Final approved edges -->
      <bpmndi:BPMNEdge id="flow_approved_to_notify_done_di" bpmnElement="flow_approved_to_notify_done">
