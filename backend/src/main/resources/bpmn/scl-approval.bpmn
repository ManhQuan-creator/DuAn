        <omgdi:waypoint x="2350" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_update_hdtv_to_gw_hdtv_di" bpmnElement="flow_update_hdtv_to_gw_hdtv">
        <omgdi:waypoint x="2450" y="298" />
        <omgdi:waypoint x="2495" y="298" />
