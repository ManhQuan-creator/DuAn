      <!-- HDTV edges -->
      <bpmndi:BPMNEdge id="flow_notify_hdtv_to_hdtv_di" bpmnElement="flow_notify_hdtv_to_hdtv">
        <omgdi:waypoint x="2150" y="298" />
        <omgdi:waypoint x="2200" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_hdtv_to_update_hdtv_di" bpmnElement="flow_hdtv_to_update_hdtv">
