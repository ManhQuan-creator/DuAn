        <omgdi:waypoint x="1945" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_tgd_approved_di" bpmnElement="flow_tgd_approved">
        <omgdi:waypoint x="1995" y="298" />
        <omgdi:waypoint x="2050" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_tgd_return_di" bpmnElement="flow_tgd_return">
        <omgdi:waypoint x="1970" y="323" />
        <omgdi:waypoint x="1970" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_tgd_reject_di" bpmnElement="flow_tgd_reject">
